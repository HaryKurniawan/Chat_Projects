#!/bin/bash

echo "Starting pre-push build check..."

# 1. Build Backend
echo "Building Backend..."
(cd backend && npm run build) || {
  echo "❌ Backend build gagal! Perbaiki kode sebelum push."
  exit 1
}

# 2. Build Frontend
echo "Building Frontend..."
(cd frontend && npm run build) || {
  echo "❌ Frontend build gagal! Perbaiki kode sebelum push."
  exit 1
}

echo "✅ Build berhasil! Melanjutkan push..."
exit 0
