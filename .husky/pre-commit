#!/bin/bash

echo "🚀 Starting pre-commit checks..."

# 1. Jalankan security scan
bash scripts/security-scan.sh
if [ $? -ne 0 ]; then
  echo "❌ Security scan gagal. Commit dibatalkan."
  exit 1
fi

# 2. Jalankan lint-staged (Eslint frontend & Type-check backend)
echo "🧹 Running lint-staged..."
npx lint-staged
if [ $? -ne 0 ]; then
  echo "❌ Linting atau type-check gagal. Commit dibatalkan."
  exit 1
fi

echo "✨ Semua pengecekan berhasil! Melanjutkan ke commit message..."
exit 0